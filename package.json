{
  "name": "party-game-engine",
  "version": "0.1.0",
  "description": "An open-source engine for phone-and-TV party games. Describe a game to Claude and play it on your TV in minutes.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run typecheck && npm run build && npm test",
    "start": "node dist/server/main.js",
    "validate": "node dist/cli/validate.js"
  },
  "devDependencies": {
    "@types/node": "22.20.7",
    "@types/qrcode": "^1.5.5",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  }
}
